<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- `full` only. The Apps screen's per-app drain estimate needs to resolve labels
         and icons for whichever packages `UsageStatsManager` reports foreground time
         for: any app the user has used, most of which this app has no other
         relationship with and has never declared under queries, which is the exact
         case QUERY_ALL_PACKAGES exists for. (An earlier per-uid CPU-time feature
         relied on this same permission for the same reason, reading arbitrary uids'
         packages from PackageManager instead of UsageStatsManager, but needing
         QUERY_ALL_PACKAGES just as much. That feature was deleted for an unrelated
         reason, BATTERY_STATS rather than this permission, and this justification was
         updated to name its replacement.) Play does not approve this permission for a
         battery tool's declared category, so the `play` flavour omits it entirely (no
         corresponding entry in src/play/AndroidManifest.xml) and AppLabelResolver's two
         implementations degrade accordingly; see data/apps/AppLabelResolver.kt for how
         that split actually works.

         tools:ignore suppresses lint's QueryAllPackagesPermission check, which exists to
         catch an accidental or lazy reach for this permission, and this is neither: it is
         the entire, deliberate reason this flavour exists, already justified above and in
         the task report, not a warning being silenced to make a number look better. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

</manifest>
