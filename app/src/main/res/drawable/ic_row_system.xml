<?xml version="1.0" encoding="utf-8"?>
<!--
     Stands in for a platform uid whose icon this app could not resolve.

     A chip outline rather than a cog: a cog is Android's own settings glyph and would
     read as "tap to configure" on a row that is not tappable. This says "part of the
     phone itself", which is what a system uid is.

     Drawn at 24dp and tinted by the caller, so it occupies exactly the slot a real
     launcher icon does; a row without an icon must not look like a smaller row.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:pathData="M8,8h8v8h-8z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M10,5v3M14,5v3M10,16v3M14,16v3M5,10h3M5,14h3M16,10h3M16,14h3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
</vector>
