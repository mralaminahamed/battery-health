<?xml version="1.0" encoding="utf-8"?>
<!--
  The cell itself: a graphite body with a recessed gauge window and the measured trace
  across it. Drawn as an object with a lit top edge rather than a flat glyph, so it matches
  the Play Store icon.

  Everything sits inside the 72dp safe zone (x 18..90) and its diagonal stays under 72dp,
  so a circular launcher mask cannot clip the body. No shadows or filters — VectorDrawable
  supports neither, and the launcher applies its own elevation anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

        <group android:scaleX="1.16" android:scaleY="1.16"
           android:pivotX="54" android:pivotY="54">
<!-- positive terminal, drawn first so the body overlaps it -->
    <path android:pathData="M74,48 L78,48 A3,3 0 0 1 81,51 L81,57 A3,3 0 0 1 78,60 L74,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="74" android:startY="48"
                android:endX="81" android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#EFF2F5" />
                <item android:offset="0.55" android:color="#9AA2AC" />
                <item android:offset="1.0" android:color="#D7DCE2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- graphite body, lit from the top-left -->
    <path android:pathData="M33,37 L69,37 A7,7 0 0 1 76,44 L76,64 A7,7 0 0 1 69,71 L33,71 A7,7 0 0 1 26,64 L26,44 A7,7 0 0 1 33,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30" android:startY="37"
                android:endX="72" android:endY="71"
                android:type="linear">
                <item android:offset="0.0" android:color="#5A6472" />
                <item android:offset="0.18" android:color="#3C4552" />
                <item android:offset="0.55" android:color="#2A313B" />
                <item android:offset="1.0" android:color="#1D232B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- recessed gauge window -->
    <path
        android:fillColor="#141A21"
        android:pathData="M35,41 L67,41 A4,4 0 0 1 71,45 L71,63 A4,4 0 0 1 67,67 L35,67 A4,4 0 0 1 31,63 L31,45 A4,4 0 0 1 35,41 Z" />

    <!-- scale ticks: it is an instrument, so it has a scale -->
    <path
        android:strokeColor="#8D98A6"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M38,62 L38,59 M45,62 L45,60.5 M52,62 L52,59 M59,62 L59,60.5 M66,62 L66,59" />

    <!-- the measured trace -->
    <path
        android:pathData="M36,53 L42,53 L45.5,46 L50,60 L54,50 L57,53 L67,53"
        android:strokeColor="#3B82F6"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    </group>
</vector>
