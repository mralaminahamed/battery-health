# Copy to keystore.properties (gitignored) and fill in. CI can instead supply
# RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD.
#
# Generate the upload key with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias upload \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks up somewhere outside this repository. Losing it means losing the
# ability to publish updates under the same app identity.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
